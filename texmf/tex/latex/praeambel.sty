% ---------------------------------------------------------------------------- %
% Титульная страница                                                           %
% ---------------------------------------------------------------------------- %

\ifpraeambel@lyx
\else
  \ifpraeambel@beamer
    % Команда для слайда с заголовком.
    \newcommand\makebeamertitle{\frame{\maketitle}}
  \else
    % Подзаголовок на титульном листе.
    \usepackage{etoolbox}
    \providecommand{\subtitle}[1]{
      \apptocmd{\@title}{\par {\large #1 \par}}{}{}
    }
  \fi
\fi

% Более компактный заголовок статьи.
\ifpraeambel@compact
  \ifpraeambel@article
    \def\@maketitle{%
      \newpage
      \null
      \begin{center}%
        \let \footnote \thanks
        {\Large \@title \par}%
        \ifx\@author\empty
        \else
          {\large
            \lineskip .5em%
            \begin{tabular}[t]{c}%
              \@author
            \end{tabular}\par}%
        \fi%
          {\large \@date}%
      \end{center}%
      \par}
  \fi
\fi

% ---------------------------------------------------------------------------- %
% Заголовки глав и разделов в книгах                                           %
% ---------------------------------------------------------------------------- %

\ifpraeambel@book
  \usepackage[compact]{titlesec}
  \usepackage{titletoc}

  \titlecontents{part}[0pt]{\bfseries}{\partname\ \thecontentslabel:\quad}{}{\hfill\contentspage}
  \titlecontents{chapter}[0pt]{\bfseries}{\chaptername\ \thecontentslabel:\quad}{}{\hfill\contentspage}

  \gdef\thepart{\Roman{part}}

  \ifpraeambel@compact
    \titleformat{\chapter}[hang]{\normalfont\Large\bfseries}{\thechapter}{1em}{}
    \titlespacing{\chapter}{0pc}{\baselineskip}{\parskip}
  \else
    \titleformat{\chapter}[display]{\normalfont\Large\bfseries}{\chaptername~\thechapter}{0pt}{}
    \titlespacing{\chapter}{0pt}{\baselineskip}{\parskip}
  \fi

  \titleformat{\section}{\normalfont\Large\bfseries}{\thesection}{1em}{}
  \titlespacing{\section}{0pt}{\baselineskip}{\parskip}

  \titleformat{\subsection}{\normalfont\large\bfseries}{\thesubsection}{1em}{}
  \titlespacing{\subsection}{0pt}{\baselineskip}{\parskip}

  \AddToHook{cmd/appendix/after}{%
    \gdef\@chapapp{\appendixname}%
    \gdef\chaptername{\appendixname}%
    \gdef\thechapter{\Asbuk{chapter}}%
    \titleformat{\chapter}{\normalfont\Large\bfseries}{\thechapter}{1em}{}}

  \ifpraeambel@babel
    \addto{\captionsrussian}{%
      \renewcommand{\partname}{\praeambel@partname}%
      \renewcommand{\chaptername}{\praeambel@chaptername}%
    }
  \fi
\fi

\ifpraeambel@article
  \AddToHook{cmd/appendix/after}{\gdef\thesection{\Asbuk{section}}}
\fi

