% ---------------------------------------------------------------------------- %
% Размещение текста: красная строка, штрафы                                    %
% ---------------------------------------------------------------------------- %

\ifpraeambel@beamer
\else
  \ifpraeambel@lyx
  \else
    \usepackage{indentfirst}
    % Полуторный интервал.
    \usepackage{setspace}
    \onehalfspacing
    % Настройка красной строки.
    \setlength{\parindent}{12.5mm}
  \fi

  % Настройка отступа между абзацами.
  \setlength{\parskip}{\praeambel@parskip}

  \righthyphenmin=2

  \widowpenalty=10000
  \tolerance=1000
